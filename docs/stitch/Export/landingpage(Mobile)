        const iconSpan = menuBtn.querySelector('.material-symbols-outlined');
        if (iconSpan) {
          iconSpan.textContent = mobileNav.classList.contains('hidden') ? 'menu' : 'close';
        }
      });

      // Close drawer on internal anchor navigation
      mobileNav.querySelectorAll('a').forEach(anchor => {
        anchor.addEventListener('click', () => {
          mobileNav.classList.add('hidden');
          mobileNav.classList.remove('flex');
          const iconSpan = menuBtn.querySelector('.material-symbols-outlined');
          if (iconSpan) iconSpan.textContent = 'menu';
